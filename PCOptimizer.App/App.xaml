<Application x:Class="PCOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#07111F"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#081522"/>
        <SolidColorBrush x:Key="CardBackground" Color="#0D1B2A"/>
        <SolidColorBrush x:Key="CardBackground2" Color="#102235"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#138BFF"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#7446FF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2FD677"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB454"/>
        <SolidColorBrush x:Key="MutedText" Color="#9EB2C9"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#17324C"/>
    </Application.Resources>
</Application>