<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Optimizer v7.0"
        Icon="Assets\PCOptimizer-v6.ico"
        Width="1380" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#101216">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="BorderBrush" Value="#303846"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E8424F"/>
            <Setter Property="BorderBrush" Value="#FF6470"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#191C21"/>
            <Setter Property="BorderBrush" Value="#242932"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9BA6B4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Tiny" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#778291"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14171B" BorderBrush="#252A31" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PC OPTIMIZER v7.0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="SystemText" Text="Windows • Analyse en attente" Foreground="#9BA6B4" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ActionButton}" Width="105" Content="🎮 Gaming" Click="Gaming_Click"/>
                    <Button Style="{StaticResource ActionButton}" Width="125" Content="💼 Productivité" Click="Productivity_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROFIL ACTIF" Foreground="#8995A5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ProfileTitle" Text="Gaming" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ProfileText" Text="Gaming" Foreground="#58AFFF" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProfileDescription"
                                           Text="Priorité aux FPS, à la réactivité et à la stabilité. Les réglages restent réversibles."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="⚡  OPTIMISER MON PC" Height="52"
                                    VerticalAlignment="Center" Click="OptimizeAll_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OPTIMISATION WINDOWS" Foreground="#9BA6B4" FontSize="11"/>
                            <TextBlock x:Name="ScoreText" Text="-- / 100" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,4"/>
                            <ProgressBar x:Name="ScoreBar" Height="9" Minimum="0" Maximum="100" Value="0"
                                         Background="#2A3038" Foreground="#E8424F"/>
                            <TextBlock x:Name="ScoreHint" Text="Analyse ton PC pour calculer le score." Style="{StaticResource Tiny}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="DIAGNOSTIC DU PC — CARTES CLIQUABLES" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,5,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="CpuText" Text="Non analysé" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Détails CPU" Click="Analyze_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="GpuText" Text="Non analysé" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Détails GPU" Click="Analyze_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="RAM" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="RamText" Text="Non analysée" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Détails RAM" Click="Analyze_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BIOS / CARTE MÈRE" Style="{StaticResource Muted}"/>
                            <TextBlock Text="À analyser" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Détails BIOS" Click="Analyze_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="STOCKAGE PRINCIPAL" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="DiskText" Text="Non analysé" Style="{StaticResource Metric}" Margin="0,5"/>
                            <TextBlock Text="Lecteur système" Style="{StaticResource Tiny}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DÉMARRAGE" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Analyse disponible" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Gérer" Click="Optimize_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PLAN D'ALIMENTATION" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Analyse / réglage" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Détails" Click="Power_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WINDOWS" Style="{StaticResource Muted}"/>
                            <TextBlock Text="État du système" Style="{StaticResource Metric}" Margin="0,5"/>
                            <Button Style="{StaticResource ActionButton}" Content="Paramètres Windows" Click="Graphics_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="OPTIMISATIONS" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,6,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="⚡  PLAN D'ALIMENTATION" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Active le plan Performances élevées. Il privilégie les performances du processeur et la réactivité." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Activer Performances élevées" Click="Power_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="🔌  PARAMÈTRES USB" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Section prête pour les réglages USB et la stabilité des périphériques gaming." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,14"/>
                            <Button Style="{StaticResource ActionButton}" Content="Analyser les périphériques" Click="Analyze_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🎮 GAMING — FORTNITE" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Profil léger : priorité temporaire du jeu + paramètres graphiques Windows." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Optimiser Fortnite" Click="Fortnite_Click"/>
                                <Button Style="{StaticResource ActionButton}" Content="Booster" Click="GameBooster_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="💀 GAMING — CALL OF DUTY" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Priorité temporaire du processus et ouverture des paramètres graphiques Windows." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Optimiser Call of Duty" Click="CallOfDuty_Click"/>
                                <Button Style="{StaticResource ActionButton}" Content="Booster" Click="GameBooster_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🌐 RÉSEAU / LATENCE" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Purge DNS puis test de latence vers Cloudflare pour vérifier la qualité du réseau." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <Button Style="{StaticResource ActionButton}" Content="Tester la latence" Click="Network_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🖱 RÉACTIVITÉ SOURIS" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Désactive l'accélération Windows pour un comportement plus constant en jeu." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <Button Style="{StaticResource ActionButton}" Content="Appliquer" Click="Mouse_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🧹 NETTOYAGE ET STOCKAGE" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Supprime les temporaires accessibles sans toucher aux fichiers personnels." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <Button Style="{StaticResource ActionButton}" Content="Nettoyer" Click="Cleanup_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="💾 SAUVEGARDE / RESTAURATION" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Sauvegarde l'état du plan d'alimentation et des réglages souris avant les optimisations." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButton}" Content="Sauvegarder" Click="Backup_Click"/>
                                <Button Style="{StaticResource DangerButton}" Content="Restaurer" Click="Restore_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16">
                    <TextBlock x:Name="GameStatusText" Text="Fortnite / Call of Duty : détection en attente." Style="{StaticResource Muted}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#14171B" BorderBrush="#252A31" BorderThickness="0,1,0,0" Padding="18,0">
            <TextBlock x:Name="StatusText" Text="Prêt." Foreground="#9BA6B4" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>