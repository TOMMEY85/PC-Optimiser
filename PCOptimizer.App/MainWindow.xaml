<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Optimizer v7.0" Width="1320" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#07111F">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#12283E"/>
            <Setter Property="BorderBrush" Value="#244563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0B7CFF"/>
            <Setter Property="BorderBrush" Value="#43B1FF"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8D2635"/>
            <Setter Property="BorderBrush" Value="#FF6272"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0D1B2A"/>
            <Setter Property="BorderBrush" Value="#17324C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EB2C9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#081522" BorderBrush="#17324C" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18">
                <Border DockPanel.Dock="Bottom" Background="#0B1B2A" BorderBrush="#163551" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="PROFIL ACTIF" Foreground="#758EA8" FontSize="10"/>
                        <TextBlock x:Name="ProfileText" Text="Gaming" Foreground="#49B2FF" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Performance • Réactivité" Foreground="#8FA6BE" FontSize="11"/>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,28">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#0B7CFF" Margin="0,0,9,0">
                            <TextBlock Text="⚡" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PC OPTIMIZER" Foreground="White" FontWeight="Bold" FontSize="17"/>
                            <TextBlock Text="v7.0 • Gaming Edition" Foreground="#55B7FF" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="⌂   Accueil" Click="Home_Click" Background="#0D3157"/>
                    <Button Content="▣   Analyse système" Click="Analyze_Click"/>
                    <Button Content="⚡   Optimisation" Click="Optimize_Click"/>
                    <Button Content="🎮   Gaming" Click="Gaming_Click"/>
                    <Button Content="🧹   Nettoyage" Click="Cleanup_Click"/>
                    <Button Content="🌐   Réseau / latence" Click="Network_Click"/>
                    <Button Content="↻   Sauvegarde / restauration" Click="Restore_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#091827" BorderBrush="#16304A" BorderThickness="0,0,0,1" Padding="24,15">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PLUS DE PERFORMANCES. MOINS DE LIMITES." Foreground="#54B7FF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SystemText" Text="Analyse en attente" Foreground="#9EB2C9" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🎮 Gaming" Click="Gaming_Click"/>
                        <Button Content="💼 Productivité" Click="Productivity_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Bienvenue dans PC Optimizer" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                <TextBlock x:Name="ProfileTitle" Text="Gaming" Foreground="#4EB4FF" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ProfileDescription" Text="Priorité aux FPS, à la réactivité et à la stabilité." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <Button Style="{StaticResource Primary}" Content="⚡ OPTIMISER MON PC" Click="OptimizeAll_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Score performance" Foreground="#9EB2C9"/>
                                <TextBlock x:Name="ScoreText" Text="-- / 100" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,5"/>
                                <ProgressBar x:Name="ScoreBar" Height="10" Minimum="0" Maximum="100" Value="0" Background="#16293D" Foreground="#0B7CFF"/>
                                <TextBlock x:Name="ScoreHint" Text="Analyse ton PC pour calculer le score." Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource SmallText}"/><TextBlock x:Name="CpuText" Text="--" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5"/><TextBlock Text="Processeur détecté" Style="{StaticResource SmallText}"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU" Style="{StaticResource SmallText}"/><TextBlock x:Name="GpuText" Text="--" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5"/><TextBlock Text="Carte graphique" Style="{StaticResource SmallText}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM" Style="{StaticResource SmallText}"/><TextBlock x:Name="RamText" Text="--" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5"/><TextBlock Text="Mémoire physique" Style="{StaticResource SmallText}"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stockage" Style="{StaticResource SmallText}"/><TextBlock x:Name="DiskText" Text="--" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,5"/><TextBlock Text="Lecteur système" Style="{StaticResource SmallText}"/></StackPanel></Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Optimisations gaming" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource Primary}" Content="🎮 Fortnite — optimiser" Click="Fortnite_Click"/>
                                <Button Style="{StaticResource Primary}" Content="💀 Call of Duty — optimiser" Click="CallOfDuty_Click"/>
                                <Button Content="🚀 Booster les jeux en cours" Click="GameBooster_Click"/>
                                <Button Content="🖱 Désactiver l'accélération souris" Click="Mouse_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Windows / réseau" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource Primary}" Content="⚡ Mode performances élevées" Click="Power_Click"/>
                                <Button Content="🌐 Diagnostiquer la latence" Click="Network_Click"/>
                                <Button Content="🪟 Paramètres graphiques Windows" Click="Graphics_Click"/>
                                <Button Content="🧹 Nettoyer les temporaires" Click="Cleanup_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Jeux détectés" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock x:Name="GameStatusText" Text="Recherche de Fortnite et Call of Duty..." Style="{StaticResource SmallText}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Le booster applique une priorité temporaire uniquement aux processus déjà lancés." Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Sauvegarde / restauration" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Avant les optimisations, PC Optimizer enregistre l'état du plan d'alimentation et des réglages souris." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <Button Content="💾 Sauvegarder l'état actuel" Click="Backup_Click"/>
                                <Button Style="{StaticResource Danger}" Content="↻ Restaurer le dernier état" Click="Restore_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#081522" BorderBrush="#17314A" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock x:Name="StatusText" Text="Prêt." Foreground="#A6BDD4" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>