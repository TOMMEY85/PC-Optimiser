<Window x:Class="PCOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PC Optimizer v7.0" Width="1500" Height="930" MinWidth="1180" MinHeight="760"
 WindowStartupLocation="CenterScreen" Background="#050A14" FontFamily="Segoe UI">
<Window.Resources>
<LinearGradientBrush x:Key="BG" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#06111E"/><GradientStop Color="#071B30" Offset=".5"/><GradientStop Color="#10091D" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="Blue" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00C6FF"/><GradientStop Color="#087BFF" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="Purple" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6E5BFF"/><GradientStop Color="#B446FF" Offset="1"/></LinearGradientBrush>
<SolidColorBrush x:Key="Card" Color="#0C1727"/><SolidColorBrush x:Key="Card2" Color="#091421"/><SolidColorBrush x:Key="Border" Color="#193650"/>
<Style x:Key="Nav" TargetType="Button"><Setter Property="Foreground" Value="#B7C7D9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="Active" TargetType="Button" BasedOn="{StaticResource Nav}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0B4E9B"/><Setter Property="BorderBrush" Value="#139BFF"/><Setter Property="BorderThickness" Value="1"/></Style>
<Style x:Key="Btn" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#112840"/><Setter Property="BorderBrush" Value="#294A67"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="BlueBtn" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="BorderBrush" Value="#39C7FF"/></Style>
<Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="{StaticResource Purple}"/><Setter Property="BorderBrush" Value="#B38CFF"/></Style>
<Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="#17A96B"/><Setter Property="BorderBrush" Value="#55F1A8"/></Style>
<Style x:Key="TealBtn" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="#00A9B8"/><Setter Property="BorderBrush" Value="#4DE9F5"/></Style>
<Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="#7C2532"/><Setter Property="BorderBrush" Value="#FF6473"/></Style>
<Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
<Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#91A6BB"/><Setter Property="FontSize" Value="12"/></Style>
<Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/></Style>
</Window.Resources>

<Grid Background="{StaticResource BG}">
<Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

<Border Grid.Row="0" Background="#081422" BorderBrush="#17334F" BorderThickness="0,0,0,1">
<Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource Blue}"><TextBlock Text="⚡" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="PC OPTIMIZER" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="PLUS DE PERFORMANCES. MOINS DE LIMITES." Foreground="#62C8FF" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Style="{StaticResource Active}" Width="115" Content="⌂  Accueil" Click="Home_Click"/><Button Style="{StaticResource Nav}" Width="125" Content="⚡  Optimisation" Click="Optimize_Click"/><Button Style="{StaticResource Nav}" Width="105" Content="🎮  Gaming" Click="Gaming_Click"/><Button Style="{StaticResource Nav}" Width="105" Content="🛠  Outils" Click="Analyze_Click"/><Button Style="{StaticResource Nav}" Width="110" Content="⚙  Réglages" Click="Productivity_Click"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Mode Expert" Foreground="#91A6BB" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Width="48" Height="24" Background="#162840" CornerRadius="12" BorderBrush="#28517A"><Ellipse Width="16" Height="16" Fill="#8FA5BB" HorizontalAlignment="Left" Margin="4,0,0,0"/></Border></StackPanel>
</Grid></Border>

<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<Border Grid.Column="0" Background="#06101C" BorderBrush="#11283E" BorderThickness="0,0,1,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="MENU PRINCIPAL" Foreground="#526B83" FontSize="10" FontWeight="Bold" Margin="8,10,0,7"/>
<Button Style="{StaticResource Active}" Content="⌂   Accueil" Click="Home_Click"/><Button Style="{StaticResource Nav}" Content="▣   Analyse système" Click="Analyze_Click"/><Button Style="{StaticResource Nav}" Content="⚡   Optimisation" Click="Optimize_Click"/><Button Style="{StaticResource Nav}" Content="🎮   Gaming" Click="Gaming_Click"/><Button Style="{StaticResource Nav}" Content="🧹   Nettoyage" Click="Cleanup_Click"/><Button Style="{StaticResource Nav}" Content="◔   Démarrage" Click="Analyze_Click"/><Button Style="{StaticResource Nav}" Content="▣   Services" Click="Analyze_Click"/><Button Style="{StaticResource Nav}" Content="🌐   Réseau" Click="Network_Click"/><Button Style="{StaticResource Nav}" Content="🛠   Outils avancés" Click="Analyze_Click"/><Button Style="{StaticResource Nav}" Content="💾   Sauvegarde / Restauration" Click="Restore_Click"/><Button Style="{StaticResource Nav}" Content="ℹ   À propos" Click="Home_Click"/></StackPanel>
<Border Grid.Row="1" Background="#0B1B2C" BorderBrush="#1B3B58" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="PROFIL ACTIF" Foreground="#58718A" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ProfileText" Text="Gaming" Foreground="#44B8FF" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="FPS • Réactivité • Faible latence" Foreground="#93A9BC" FontSize="10"/></StackPanel></Border>
</Grid></Border>

<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,16,20,18">

<Border Background="#0C2340" BorderBrush="#214C75" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,12"><Grid><StackPanel><TextBlock Text="Bienvenue dans PC Optimizer" Foreground="White" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="ProfileTitle" Text="Gaming" Foreground="#55C1FF" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Optimise ton PC en un clic et révèle tout son potentiel." Foreground="#A9BACB" FontSize="13" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="« Un PC optimisé, c’est plus de temps pour ce que tu aimes. »" Foreground="#C8D6E4" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="— PC Optimizer" Foreground="#738AA2" FontSize="10" HorizontalAlignment="Right"/></StackPanel></Grid></Border>

<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width=".72*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="🖥  Résumé système" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Détails complets →" Foreground="#4DBFFF" HorizontalAlignment="Right"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<Border Grid.Row="0" Grid.Column="0" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,7,7"><StackPanel><TextBlock Text="Processeur" Style="{StaticResource Muted}"/><TextBlock x:Name="CpuText" Text="Non analysé" Style="{StaticResource Value}"/><TextBlock Text="CPU système" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Grid.Row="0" Grid.Column="1" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="7,0,0,7"><StackPanel><TextBlock Text="Carte graphique" Style="{StaticResource Muted}"/><TextBlock x:Name="GpuText" Text="Non analysée" Style="{StaticResource Value}"/><TextBlock Text="GPU système" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Grid.Row="1" Grid.Column="0" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,7,7"><StackPanel><TextBlock Text="Mémoire RAM" Style="{StaticResource Muted}"/><TextBlock x:Name="RamText" Text="Non analysée" Style="{StaticResource Value}"/><TextBlock Text="Mémoire physique" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Grid.Row="1" Grid.Column="1" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="7,0,0,7"><StackPanel><TextBlock Text="Stockage" Style="{StaticResource Muted}"/><TextBlock x:Name="DiskText" Text="Non analysé" Style="{StaticResource Value}"/><TextBlock Text="Lecteur système" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Grid.Row="2" Grid.Column="0" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="Carte mère" Style="{StaticResource Muted}"/><TextBlock Text="Analyse système" Style="{StaticResource Value}"/><TextBlock Text="BIOS / chipset" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Grid.Row="2" Grid.Column="1" Background="#0A1B2D" BorderBrush="#193B58" BorderThickness="1" CornerRadius="11" Padding="10" Margin="7,0,0,0"><StackPanel><TextBlock Text="Températures" Style="{StaticResource Muted}"/><TextBlock Text="CPU  —" Foreground="#38E897" FontSize="12" FontWeight="Bold"/><TextBlock Text="GPU  —" Foreground="#38E897" FontSize="12" FontWeight="Bold"/></StackPanel></Border>
</Grid></StackPanel></Border>

<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Score de performance" Foreground="White" FontSize="16" FontWeight="Bold"/><Grid Width="170" Height="150" Margin="0,6"><Ellipse Stroke="#20394F" StrokeThickness="12"/><Ellipse Width="130" Height="130" Stroke="{StaticResource Blue}" StrokeThickness="10"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="ScoreText" Text="-- / 100" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Bon potentiel !" Foreground="#35E28B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="ScoreHint" Text="Analyse ton PC pour calculer le score." Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/><ProgressBar x:Name="ScoreBar" Height="6" Width="180" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,12" Background="#1B2D3F"/><Button Style="{StaticResource BlueBtn}" Content="⚡  Lancer une optimisation complète" Click="OptimizeAll_Click" Width="190"/></StackPanel></Border>

<Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Profil actif" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="🎮" Foreground="#36B9FF" FontSize="29" Margin="0,7,0,0"/><TextBlock Text="Gaming" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="ProfileDescription" Text="Priorité aux FPS, faible latence et réactivité maximale." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,9"/><Button Style="{StaticResource Btn}" Content="Changer de profil" Click="Productivity_Click"/><TextBlock Text="Profils rapides" Foreground="#8498AD" FontSize="10" FontWeight="Bold" Margin="0,8,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource BlueBtn}" Content="🎮 Gaming" Click="Gaming_Click"/><Button Grid.Column="1" Style="{StaticResource Btn}" Content="💼 Productivité" Click="Productivity_Click"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource Btn}" Content="🖥 Quotidien" Click="Productivity_Click"/><Button Grid.Column="1" Style="{StaticResource Btn}" Content="🎨 Création" Click="Productivity_Click"/></Grid></StackPanel></Border>
</Grid>

<Border Style="{StaticResource CardStyle}" Padding="15">
<StackPanel>
<TextBlock Text="✅  Optimisations actives" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
<TextBlock Text="Chaque réglage affiche immédiatement son état. ON applique l'optimisation ; OFF restaure le dernier état sauvegardé." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0A1A2A" CornerRadius="11" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="⚡ Performances élevées" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="PowerStateText" Text="OFF" Foreground="#7E93A8" FontWeight="Bold" Margin="0,4,0,6"/><CheckBox x:Name="PowerToggle" Content="ON / OFF" Foreground="White" Checked="PowerToggle_Checked" Unchecked="PowerToggle_Unchecked"/></StackPanel></Border>
<Border Grid.Column="1" Background="#0A1A2A" CornerRadius="11" Padding="12" Margin="4,0,4,0"><StackPanel><TextBlock Text="🖱 Souris sans accélération" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="MouseStateText" Text="OFF" Foreground="#7E93A8" FontWeight="Bold" Margin="0,4,0,6"/><CheckBox x:Name="MouseToggle" Content="ON / OFF" Foreground="White" Checked="MouseToggle_Checked" Unchecked="MouseToggle_Unchecked"/></StackPanel></Border>
<Border Grid.Column="2" Background="#0A1A2A" CornerRadius="11" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock Text="🌐 Profil réseau gaming" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="NetworkStateText" Text="OFF" Foreground="#7E93A8" FontWeight="Bold" Margin="0,4,0,6"/><CheckBox x:Name="NetworkToggle" Content="ON / OFF" Foreground="White" Checked="NetworkToggle_Checked" Unchecked="NetworkToggle_Unchecked"/></StackPanel></Border>
</Grid>
</StackPanel>
</Border>

<Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="⚡  Optimisations rapides" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0A1A2A" CornerRadius="11" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="▣  Windows" Foreground="White" FontWeight="Bold"/><TextBlock Text="Paramètres système" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Style="{StaticResource BlueBtn}" Content="Optimiser" Click="Optimize_Click"/></StackPanel></Border>
<Border Grid.Column="1" Background="#0A1A2A" CornerRadius="11" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="🧹  Nettoyage" Foreground="White" FontWeight="Bold"/><TextBlock Text="Fichiers inutiles" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Style="{StaticResource GreenBtn}" Content="Nettoyer" Click="Cleanup_Click"/></StackPanel></Border>
<Border Grid.Column="2" Background="#0A1A2A" CornerRadius="11" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="◔  Démarrage" Foreground="White" FontWeight="Bold"/><TextBlock Text="Programmes Windows" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Style="{StaticResource PurpleBtn}" Content="Optimiser" Click="Analyze_Click"/></StackPanel></Border>
<Border Grid.Column="3" Background="#0A1A2A" CornerRadius="11" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="⚙  Services" Foreground="White" FontWeight="Bold"/><TextBlock Text="Services Windows" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Style="{StaticResource Btn}" Content="Analyser" Click="Analyze_Click"/></StackPanel></Border>
<Border Grid.Column="4" Background="#0A1A2A" CornerRadius="11" Padding="10" Margin="6,0,0,0"><StackPanel><TextBlock Text="◉  Latence" Foreground="White" FontWeight="Bold"/><TextBlock Text="Connexion gaming" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Style="{StaticResource TealBtn}" Content="Optimiser" Click="Network_Click"/></StackPanel></Border>
</Grid></StackPanel></Border>

<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><DockPanel><TextBlock Text="🎮  Jeux détectés" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Jeux compatibles" Foreground="#5CBFFF" HorizontalAlignment="Right"/></DockPanel><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0A1B2D" BorderBrush="#234966" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,7,0"><StackPanel><Border Height="55" Background="#14253A" CornerRadius="8"><TextBlock Text="FORTNITE" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="✓  Optimisable" Foreground="#36E38C" FontSize="10" Margin="0,6,0,0"/><Button Style="{StaticResource BlueBtn}" Content="Optimiser" Click="Fortnite_Click" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="#0A1B2D" BorderBrush="#234966" BorderThickness="1" CornerRadius="11" Padding="10" Margin="4,0,4,0"><StackPanel><Border Height="55" Background="#14253A" CornerRadius="8"><TextBlock Text="CALL OF DUTY" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="✓  Optimisable" Foreground="#36E38C" FontSize="10" Margin="0,6,0,0"/><Button Style="{StaticResource BlueBtn}" Content="Optimiser" Click="CallOfDuty_Click" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="#071421" BorderBrush="#2A4762" BorderThickness="1" CornerRadius="11" Padding="10" Margin="7,0,0,0"><StackPanel><Border Height="55" Background="#0D2033" CornerRadius="8"><TextBlock Text="＋" Foreground="#7FA1BE" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Ajouter un jeu" Foreground="#B4C5D6" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="manuellement" Foreground="#647D95" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border></Grid><TextBlock x:Name="GameStatusText" Text="Détection en cours..." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><DockPanel><TextBlock Text="🛠  Outils système" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="Voir tous les outils →" Foreground="#5CBFFF" HorizontalAlignment="Right"/></DockPanel><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Btn}" Content="☘  Plan alimentation" Click="Power_Click"/><Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Btn}" Content="▣  TRIM SSD" Click="Analyze_Click"/><Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Btn}" Content="⇩  Pilotes" Click="Analyze_Click"/><Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Btn}" Content="▣  S.M.A.R.T." Click="Analyze_Click"/><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Content="ⓘ  Infos système" Click="Analyze_Click"/><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Content="▥  Moniteur FPS" Click="GameBooster_Click"/></Grid></StackPanel></Border>
</Grid>

<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="💾  Sauvegarde / restauration" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="Sauvegarde avant modification" Style="{StaticResource Muted}" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Btn}" Content="Sauvegarder" Click="Backup_Click"/><Button Style="{StaticResource DangerBtn}" Content="Restaurer" Click="Restore_Click"/></StackPanel></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="🌐  Réseau / latence" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="DNS + ping" Style="{StaticResource Muted}" Margin="0,4,0,8"/><Button Style="{StaticResource Btn}" Content="Tester la connexion" Click="Network_Click"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="🧹  Nettoyage" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="Temporaires Windows" Style="{StaticResource Muted}" Margin="0,4,0,8"/><Button Style="{StaticResource GreenBtn}" Content="Nettoyer maintenant" Click="Cleanup_Click"/></StackPanel></Border>
</Grid>

</StackPanel></ScrollViewer>
</Grid>

<Border Grid.Row="2" Background="#06101B" BorderBrush="#12263D" BorderThickness="0,1,0,0" Padding="18,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="#37DF86" Margin="0,0,7,0"/><TextBlock Text="Système prêt" Foreground="#35DD87" FontWeight="Bold" FontSize="11"/><TextBlock Text="  •  PC Optimizer v7.0" Foreground="#71869D" FontSize="11"/></StackPanel><TextBlock x:Name="SystemText" Text="Windows • Analyse en attente" Foreground="#93A7BA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Prêt." Foreground="#93A7BA" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
</Grid>
</Window>